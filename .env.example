# The four-stage web demo runs without an API key in offline fallback mode.
OPENAI_API_KEY=
B2G_MODEL=gpt-4.1-mini
B2G_LLM_ENABLED=false

# Optional real-simulator paths used by the legacy single-building workflow.
# They are not required for the Harborview web demo.
ENERGYPLUS_EXE=
ENERGYPLUS_IDF=
ENERGYPLUS_EPW=

# Never commit your populated .env file.
